#cloud-config
package_update: true
packages: [docker.io, python3]
write_files:
  - path: /opt/custom-responses/panel.html
    permissions: "0644"
    encoding: b64
    content: ${panel}
  - path: /opt/custom-responses/fixture.py
    permissions: "0644"
    encoding: b64
    content: ${fixture}
  - path: /opt/custom-responses/scenarios.json
    permissions: "0644"
    encoding: b64
    content: ${inventory}
  - path: /etc/systemd/system/custom-responses.service
    permissions: "0644"
    content: |
      [Unit]
      After=network-online.target docker.service
      Wants=network-online.target
      [Service]
      User=www-data
      WorkingDirectory=/opt/custom-responses
      ExecStart=/usr/bin/python3 /opt/custom-responses/fixture.py
      Restart=on-failure
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectSystem=strict
      ProtectHome=true
      [Install]
      WantedBy=multi-user.target
runcmd:
  - [systemctl, enable, --now, docker]
  - [
      docker,
      run,
      -d,
      --restart=unless-stopped,
      --name,
      httpbin,
      -p,
      "127.0.0.1:8085:8080",
      "${httpbin_image}",
    ]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, custom-responses]
