{
  "resource": {
    "xcsh_namespace": {
      "showcase": {
        "name": "custom-responses",
        "labels": {
          "project": "custom-responses",
          "managed_by": "terraform"
        }
      }
    },
    "xcsh_origin_pool": {
      "healthy": {
        "name": "cr-healthy-pool",
        "namespace": "${xcsh_namespace.showcase.name}",
        "port": 8080,
        "no_tls": {},
        "origin_servers": [
          {
            "public_ip": [
              {
                "ip": "${azurerm_public_ip.origin.ip_address}"
              }
            ]
          }
        ]
      },
      "status500": {
        "name": "cr-status500-pool",
        "namespace": "${xcsh_namespace.showcase.name}",
        "port": 8081,
        "no_tls": {},
        "origin_servers": [
          {
            "public_ip": [
              {
                "ip": "${azurerm_public_ip.origin.ip_address}"
              }
            ]
          }
        ]
      },
      "reset": {
        "name": "cr-reset-pool",
        "namespace": "${xcsh_namespace.showcase.name}",
        "port": 8082,
        "no_tls": {},
        "origin_servers": [
          {
            "public_ip": [
              {
                "ip": "${azurerm_public_ip.origin.ip_address}"
              }
            ]
          }
        ]
      },
      "closed": {
        "name": "cr-closed-pool",
        "namespace": "${xcsh_namespace.showcase.name}",
        "port": 8083,
        "no_tls": {},
        "origin_servers": [
          {
            "public_ip": [
              {
                "ip": "${azurerm_public_ip.origin.ip_address}"
              }
            ]
          }
        ]
      },
      "delay": {
        "name": "cr-delay-pool",
        "namespace": "${xcsh_namespace.showcase.name}",
        "port": 8084,
        "no_tls": {},
        "origin_servers": [
          {
            "public_ip": [
              {
                "ip": "${azurerm_public_ip.origin.ip_address}"
              }
            ]
          }
        ]
      }
    },
    "xcsh_app_firewall": {
      "waf-html": {
        "name": "cr-waf-html",
        "namespace": "${xcsh_namespace.showcase.name}",
        "blocking": {},
        "blocking_page": [
          {
            "response_code": "Forbidden",
            "blocking_page": "string:"
          }
        ],
        "detection_settings": [
          {
            "disable_staging": {},
            "disable_suppression": {},
            "signature_selection_setting": [
              {
                "high_medium_accuracy_signatures": {},
                "default_attack_type_settings": {}
              }
            ],
            "default_violation_settings": {},
            "default_bot_setting": {},
            "enable_threat_campaigns": {}
          }
        ]
      },
      "waf-json": {
        "name": "cr-waf-json",
        "namespace": "${xcsh_namespace.showcase.name}",
        "blocking": {},
        "blocking_page": [
          {
            "response_code": "Forbidden",
            "blocking_page": "string:///eyJtZXNzYWdlIjogIlJlcXVlc3Qgbm90IGFjY2VwdGVkIiwgInNob3djYXNlIjogImN1c3RvbS1yZXNwb25zZXMifQ=="
          }
        ],
        "detection_settings": [
          {
            "disable_staging": {},
            "disable_suppression": {},
            "signature_selection_setting": [
              {
                "high_medium_accuracy_signatures": {},
                "default_attack_type_settings": {}
              }
            ],
            "default_violation_settings": {},
            "default_bot_setting": {},
            "enable_threat_campaigns": {}
          }
        ]
      }
    },
    "xcsh_http_loadbalancer": {
      "errors": {
        "name": "cr-errors",
        "namespace": "${xcsh_namespace.showcase.name}",
        "domains": ["cr-errors.f5-sales-demo.com"],
        "advertise_on_public_default_vip": {},
        "https_auto_cert": [
          {
            "http_redirect": true
          }
        ],
        "default_route_pools": [
          {
            "pool": [
              {
                "name": "${xcsh_origin_pool.healthy.name}",
                "namespace": "${xcsh_namespace.showcase.name}"
              }
            ],
            "weight": 1,
            "priority": 1
          }
        ],
        "more_option": [
          {
            "custom_errors": {
              "3": "string:",
              "4": "string:",
              "5": "string:",
              "404": "string:",
              "503": "string:"
            }
          }
        ],
        "routes": [
          {
            "simple_route": [
              {
                "path": [
                  {
                    "path": "/fault/500"
                  }
                ],
                "origin_pools": [
                  {
                    "pool": [
                      {
                        "name": "${xcsh_origin_pool.status500.name}",
                        "namespace": "${xcsh_namespace.showcase.name}"
                      }
                    ],
                    "weight": 1,
                    "priority": 1
                  }
                ],
                "http_method": "ANY"
              }
            ]
          },
          {
            "simple_route": [
              {
                "path": [
                  {
                    "path": "/fault/502"
                  }
                ],
                "origin_pools": [
                  {
                    "pool": [
                      {
                        "name": "${xcsh_origin_pool.reset.name}",
                        "namespace": "${xcsh_namespace.showcase.name}"
                      }
                    ],
                    "weight": 1,
                    "priority": 1
                  }
                ],
                "http_method": "ANY"
              }
            ]
          },
          {
            "simple_route": [
              {
                "path": [
                  {
                    "path": "/fault/503"
                  }
                ],
                "origin_pools": [
                  {
                    "pool": [
                      {
                        "name": "${xcsh_origin_pool.closed.name}",
                        "namespace": "${xcsh_namespace.showcase.name}"
                      }
                    ],
                    "weight": 1,
                    "priority": 1
                  }
                ],
                "http_method": "ANY"
              }
            ]
          },
          {
            "simple_route": [
              {
                "path": [
                  {
                    "path": "/fault/504"
                  }
                ],
                "origin_pools": [
                  {
                    "pool": [
                      {
                        "name": "${xcsh_origin_pool.delay.name}",
                        "namespace": "${xcsh_namespace.showcase.name}"
                      }
                    ],
                    "weight": 1,
                    "priority": 1
                  }
                ],
                "advanced_options": [
                  {
                    "timeout": 2000,
                    "no_retry_policy": {},
                    "priority": "DEFAULT"
                  }
                ],
                "http_method": "ANY"
              }
            ]
          }
        ]
      },
      "actions": {
        "name": "cr-index",
        "namespace": "${xcsh_namespace.showcase.name}",
        "domains": ["custom-responses.f5-sales-demo.com"],
        "advertise_on_public_default_vip": {},
        "https_auto_cert": [
          {
            "http_redirect": true
          }
        ],
        "default_route_pools": [
          {
            "pool": [
              {
                "name": "${xcsh_origin_pool.healthy.name}",
                "namespace": "${xcsh_namespace.showcase.name}"
              }
            ],
            "weight": 1,
            "priority": 1
          }
        ],
        "routes": [
          {
            "direct_response_route": [
              {
                "path": [
                  {
                    "path": "/maintenance"
                  }
                ],
                "route_direct_response": [
                  {
                    "response_code": 503,
                    "response_body_encoded": "string:"
                  }
                ],
                "http_method": "ANY"
              }
            ]
          },
          {
            "direct_response_route": [
              {
                "path": [
                  {
                    "path": "/acknowledgement"
                  }
                ],
                "route_direct_response": [
                  {
                    "response_code": 200,
                    "response_body_encoded": "string:"
                  }
                ],
                "http_method": "ANY"
              }
            ]
          },
          {
            "redirect_route": [
              {
                "path": [
                  {
                    "path": "/old"
                  }
                ],
                "route_redirect": [
                  {
                    "proto_redirect": "https",
                    "path_redirect": "/new",
                    "response_code": 302
                  }
                ],
                "http_method": "ANY"
              }
            ]
          }
        ],
        "more_option": [
          {
            "response_headers_to_add": [
              {
                "name": "x-showcase",
                "value": "custom-responses",
                "append": false
              }
            ],
            "response_headers_to_remove": ["x-origin-remove"],
            "response_cookies_to_add": [
              {
                "name": "showcase",
                "value": "custom-responses",
                "add_path": "/",
                "add_secure": {},
                "add_httponly": {},
                "samesite_lax": {},
                "overwrite": true
              }
            ],
            "response_cookies_to_remove": ["origin-remove"]
          }
        ]
      },
      "waf-html": {
        "name": "cr-waf-html",
        "namespace": "${xcsh_namespace.showcase.name}",
        "domains": ["cr-waf-html.f5-sales-demo.com"],
        "advertise_on_public_default_vip": {},
        "https_auto_cert": [
          {
            "http_redirect": true
          }
        ],
        "default_route_pools": [
          {
            "pool": [
              {
                "name": "${xcsh_origin_pool.healthy.name}",
                "namespace": "${xcsh_namespace.showcase.name}"
              }
            ],
            "weight": 1,
            "priority": 1
          }
        ],
        "app_firewall": [
          {
            "name": "${xcsh_app_firewall.waf-html.name}",
            "namespace": "${xcsh_namespace.showcase.name}"
          }
        ]
      },
      "waf-json": {
        "name": "cr-waf-json",
        "namespace": "${xcsh_namespace.showcase.name}",
        "domains": ["cr-waf-json.f5-sales-demo.com"],
        "advertise_on_public_default_vip": {},
        "https_auto_cert": [
          {
            "http_redirect": true
          }
        ],
        "default_route_pools": [
          {
            "pool": [
              {
                "name": "${xcsh_origin_pool.healthy.name}",
                "namespace": "${xcsh_namespace.showcase.name}"
              }
            ],
            "weight": 1,
            "priority": 1
          }
        ],
        "app_firewall": [
          {
            "name": "${xcsh_app_firewall.waf-json.name}",
            "namespace": "${xcsh_namespace.showcase.name}"
          }
        ],
        "sensitive_data_disclosure_rules": [
          {
            "sensitive_data_types_in_response": [
              {
                "api_endpoint": [
                  {
                    "path": "/disclosure",
                    "methods": ["GET"]
                  }
                ],
                "body": [
                  {
                    "fields": ["card", "ssn"]
                  }
                ],
                "mask": {}
              }
            ]
          }
        ],
        "data_guard_rules": [
          {
            "metadata": [
              {
                "name": "mask-synthetic"
              }
            ],
            "any_domain": {},
            "path": [
              {
                "path": "/data-guard"
              }
            ],
            "apply_data_guard": {}
          }
        ]
      },
      "js": {
        "name": "cr-js",
        "namespace": "${xcsh_namespace.showcase.name}",
        "domains": ["cr-js.f5-sales-demo.com"],
        "advertise_on_public_default_vip": {},
        "https_auto_cert": [
          {
            "http_redirect": true
          }
        ],
        "default_route_pools": [
          {
            "pool": [
              {
                "name": "${xcsh_origin_pool.healthy.name}",
                "namespace": "${xcsh_namespace.showcase.name}"
              }
            ],
            "weight": 1,
            "priority": 1
          }
        ],
        "js_challenge": [
          {
            "cookie_expiry": 300,
            "custom_page": "string:///PHA+UGxlYXNlIHdhaXQgd2hpbGUgeW91ciBicm93c2VyIGlzIHZlcmlmaWVkLjwvcD4=",
            "js_script_delay": 1000
          }
        ]
      },
      "captcha": {
        "name": "cr-captcha",
        "namespace": "${xcsh_namespace.showcase.name}",
        "domains": ["cr-captcha.f5-sales-demo.com"],
        "advertise_on_public_default_vip": {},
        "https_auto_cert": [
          {
            "http_redirect": true
          }
        ],
        "default_route_pools": [
          {
            "pool": [
              {
                "name": "${xcsh_origin_pool.healthy.name}",
                "namespace": "${xcsh_namespace.showcase.name}"
              }
            ],
            "weight": 1,
            "priority": 1
          }
        ],
        "captcha_challenge": [
          {
            "cookie_expiry": 300,
            "custom_page": "string:///PHA+UGxlYXNlIGNvbXBsZXRlIHRoZSB2ZXJpZmljYXRpb24gdG8gY29udGludWUuPC9wPg=="
          }
        ]
      },
      "policy": {
        "name": "cr-policy",
        "namespace": "${xcsh_namespace.showcase.name}",
        "domains": ["cr-policy.f5-sales-demo.com"],
        "advertise_on_public_default_vip": {},
        "https_auto_cert": [
          {
            "http_redirect": true
          }
        ],
        "default_route_pools": [
          {
            "pool": [
              {
                "name": "${xcsh_origin_pool.healthy.name}",
                "namespace": "${xcsh_namespace.showcase.name}"
              }
            ],
            "weight": 1,
            "priority": 1
          }
        ],
        "policy_based_challenge": [
          {
            "js_challenge_parameters": [
              {
                "cookie_expiry": 300,
                "custom_page": "string:///PHA+UGxlYXNlIHdhaXQgd2hpbGUgeW91ciBicm93c2VyIGlzIHZlcmlmaWVkLjwvcD4=",
                "js_script_delay": 1000
              }
            ],
            "no_challenge": {},
            "rule_list": [
              {
                "rules": [
                  {
                    "metadata": [
                      {
                        "name": "challenge-js-path"
                      }
                    ],
                    "spec": [
                      {
                        "any_client": {},
                        "any_ip": {},
                        "any_asn": {},
                        "path": [
                          {
                            "exact_values": ["/policy-js"]
                          }
                        ],
                        "enable_javascript_challenge": {}
                      }
                    ]
                  },
                  {
                    "metadata": [
                      {
                        "name": "challenge-captcha-path"
                      }
                    ],
                    "spec": [
                      {
                        "any_client": {},
                        "any_ip": {},
                        "any_asn": {},
                        "path": [
                          {
                            "exact_values": ["/policy-captcha"]
                          }
                        ],
                        "enable_captcha_challenge": {}
                      }
                    ]
                  }
                ]
              }
            ],
            "captcha_challenge_parameters": [
              {
                "cookie_expiry": 300,
                "custom_page": "string:///PHA+UGxlYXNlIGNvbXBsZXRlIHRoZSB2ZXJpZmljYXRpb24gdG8gY29udGludWUuPC9wPg=="
              }
            ]
          }
        ]
      },
      "ddos-js": {
        "name": "cr-ddos-js",
        "namespace": "${xcsh_namespace.showcase.name}",
        "domains": ["cr-ddos-js.f5-sales-demo.com"],
        "advertise_on_public_default_vip": {},
        "https_auto_cert": [
          {
            "http_redirect": true
          }
        ],
        "default_route_pools": [
          {
            "pool": [
              {
                "name": "${xcsh_origin_pool.healthy.name}",
                "namespace": "${xcsh_namespace.showcase.name}"
              }
            ],
            "weight": 1,
            "priority": 1
          }
        ],
        "l7_ddos_action_js_challenge": [
          {
            "cookie_expiry": 300,
            "custom_page": "string:///PHA+UGxlYXNlIHdhaXQgd2hpbGUgeW91ciBicm93c2VyIGlzIHZlcmlmaWVkLjwvcD4=",
            "js_script_delay": 1000
          }
        ]
      }
    }
  }
}
